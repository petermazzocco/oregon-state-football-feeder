# ---------- Required ----------
# Bluesky account to post as (custom-domain handle works once DNS is verified)
BSKY_HANDLE=beaverfootball.gobeavs.app
# Bluesky app password (Settings -> Privacy and security -> App passwords). NOT your main password.
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# X API v2 bearer token (developer.x.com -> your app -> Keys and tokens)
X_BEARER_TOKEN=

# ---------- Optional ----------
# X account to mirror (no @)
X_USERNAME=BeaverFootball
# Set the numeric X user ID to skip the one-time username lookup
X_USER_ID=
# Where to log in. bsky.social works for any Bluesky-hosted account.
BSKY_PDS_HOST=https://bsky.social
# Apply Bluesky's "bot" automation label to the profile on startup
BSKY_SET_BOT_LABEL=true
# How often to check X (Go duration, min 1m). Each poll that finds nothing costs ~nothing.
POLL_INTERVAL=5m
# Mirror the account's own reply threads as Bluesky threads
MIRROR_THREADS=true
# On the very first run, mirror this many recent posts (0 = only posts from now on)
BACKFILL_COUNT=0
# Give up on a single post after this many failed attempts
MAX_ATTEMPTS=3
# Log what would be posted without posting (still advances the "seen" marker)
DRY_RUN=false
POST_LANG=en
LOG_LEVEL=info
STATE_PATH=/data/state.json
HEALTH_ADDR=:8080
